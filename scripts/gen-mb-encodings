#!/usr/bin/env python3
# Regenerates src/stdlib/mb_encodings_generated.zig: mbstring's encodings in
# libmbfl's order, each with its MIME name and aliases, which is how
# php_mb_get_encoding (mbfl_name2encoding) resolves an encoding name.
#
# the data comes from a php with mbstring (the target version, or any 8.5):
#
#   make mb-encodings
#   scripts/gen-mb-encodings --php ./php     (php in docker)

import os, subprocess, sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, "src", "stdlib", "mb_encodings_generated.zig")

php = "php"
if len(sys.argv) > 2 and sys.argv[1] == "--php":
    php = sys.argv[2]

code = r'''
error_reporting(0);
foreach (mb_list_encodings() as $e) {
    $mime = mb_preferred_mime_name($e);
    echo $e, "\t", $mime === false ? "" : $mime, "\t", implode("\x1f", mb_encoding_aliases($e)), "\n";
}
'''
out = subprocess.run([php, "-r", code], check=True, capture_output=True, text=True).stdout


def zstr(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


lines = [
    "// generated by scripts/gen-mb-encodings from php's mbstring; do not edit",
    "",
    "pub const Encoding = struct { name: []const u8, mime: []const u8, aliases: []const []const u8 };",
    "",
    "pub const encodings = [_]Encoding{",
]
for row in out.splitlines():
    name, mime, aliases = row.split("\t")
    names = [a for a in aliases.split("\x1f") if a]
    lines.append("    .{ .name = %s, .mime = %s, .aliases = &.{%s} }," % (zstr(name), zstr(mime), ", ".join(zstr(a) for a in names)))
lines.append("};")
open(OUT, "w").write("\n".join(lines) + "\n")
print("wrote %s" % OUT)
