#!/usr/bin/env python3
# Regenerates src/stdlib/hash_tables_generated.zig: the constant tables of
# the hash algorithms ext/hash implements (md2's s-box, the sha-2 round
# constants, ripemd's rotation
# schedules, haval's constants, the whirlpool, tiger, snefru and gost
# tables), read from ext/hash in the php release tarball for the version in
# src/php_version.zig. regenerate whenever that version moves:
#
#   make hash-tables
#
# pass a tarball or an unpacked source tree to skip the download:
#
#   scripts/gen-hash-tables ~/Downloads/php-8.5.12.tar.xz

import os, re, sys, tarfile, tempfile, urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, "src", "stdlib", "hash_tables_generated.zig")
FILES = [
    "ext/hash/hash_md.c",
    "ext/hash/hash_sha.c",
    "ext/hash/hash_ripemd.c",
    "ext/hash/hash_haval.c",
    "ext/hash/php_hash_whirlpool_tables.h",
    "ext/hash/php_hash_tiger_tables.h",
    "ext/hash/php_hash_snefru_tables.h",
    "ext/hash/php_hash_gost_tables.h",
]

# (zig name, file, c array name, element type, shape)
TABLES = [
    ("md2_s", "hash_md.c", "MD2_S", "u8", [256]),
    ("sha256_k", "hash_sha.c", "SHA256_K", "u32", [64]),
    ("sha512_k", "hash_sha.c", "SHA512_K", "u64", [80]),
    ("ripemd_r", "hash_ripemd.c", "R", "u8", [80]),
    ("ripemd_rr", "hash_ripemd.c", "RR", "u8", [80]),
    ("ripemd_s", "hash_ripemd.c", "S", "u5", [80]),
    ("ripemd_ss", "hash_ripemd.c", "SS", "u5", [80]),
    ("haval_d0", "hash_haval.c", "D0", "u32", [8]),
    ("haval_k2", "hash_haval.c", "K2", "u32", [32]),
    ("haval_k3", "hash_haval.c", "K3", "u32", [32]),
    ("haval_k4", "hash_haval.c", "K4", "u32", [32]),
    ("haval_k5", "hash_haval.c", "K5", "u32", [32]),
    ("haval_i2", "hash_haval.c", "I2", "u8", [32]),
    ("haval_i3", "hash_haval.c", "I3", "u8", [32]),
    ("haval_i4", "hash_haval.c", "I4", "u8", [32]),
    ("haval_i5", "hash_haval.c", "I5", "u8", [32]),
    ("haval_m0", "hash_haval.c", "M0", "u8", [32]),
    ("haval_m1", "hash_haval.c", "M1", "u8", [32]),
    ("haval_m2", "hash_haval.c", "M2", "u8", [32]),
    ("haval_m3", "hash_haval.c", "M3", "u8", [32]),
    ("haval_m4", "hash_haval.c", "M4", "u8", [32]),
    ("haval_m5", "hash_haval.c", "M5", "u8", [32]),
    ("haval_m6", "hash_haval.c", "M6", "u8", [32]),
    ("haval_m7", "hash_haval.c", "M7", "u8", [32]),
    ("whirlpool_rc", "php_hash_whirlpool_tables.h", "rc", "u64", [11]),
    ("whirlpool_c0", "php_hash_whirlpool_tables.h", "C0", "u64", [256]),
    ("whirlpool_c1", "php_hash_whirlpool_tables.h", "C1", "u64", [256]),
    ("whirlpool_c2", "php_hash_whirlpool_tables.h", "C2", "u64", [256]),
    ("whirlpool_c3", "php_hash_whirlpool_tables.h", "C3", "u64", [256]),
    ("whirlpool_c4", "php_hash_whirlpool_tables.h", "C4", "u64", [256]),
    ("whirlpool_c5", "php_hash_whirlpool_tables.h", "C5", "u64", [256]),
    ("whirlpool_c6", "php_hash_whirlpool_tables.h", "C6", "u64", [256]),
    ("whirlpool_c7", "php_hash_whirlpool_tables.h", "C7", "u64", [256]),
    ("tiger", "php_hash_tiger_tables.h", "table", "u64", [4, 256]),
    ("snefru", "php_hash_snefru_tables.h", "tables", "u32", [16, 256]),
    ("gost_test", "php_hash_gost_tables.h", "tables_test", "u32", [4, 256]),
    ("gost_crypto", "php_hash_gost_tables.h", "tables_crypto", "u32", [4, 256]),
]


def target_version():
    text = open(os.path.join(REPO, "src", "php_version.zig")).read()
    parts = [re.search(r"pub const %s = (\d+);" % name, text).group(1) for name in ("major", "minor", "release")]
    return ".".join(parts)


def sources(version, given):
    out = {}
    if given and os.path.isdir(given):
        for member in FILES:
            out[os.path.basename(member)] = open(os.path.join(given, member)).read()
        return out
    path = given
    if not path:
        path = os.path.join(tempfile.gettempdir(), "php-%s.tar.xz" % version)
        if not os.path.exists(path):
            url = "https://www.php.net/distributions/php-%s.tar.xz" % version
            print("downloading " + url, file=sys.stderr)
            urllib.request.urlretrieve(url, path)
    with tarfile.open(path) as tar:
        for member in tar.getmembers():
            for wanted in FILES:
                if member.name.endswith("/" + wanted):
                    out[os.path.basename(wanted)] = tar.extractfile(member).read().decode()
    missing = [f for f in FILES if os.path.basename(f) not in out]
    if missing:
        sys.exit("missing in %s: %s" % (path, ", ".join(missing)))
    return out


def strip_comments(source):
    source = re.sub(r"/\*.*?\*/", " ", source, flags=re.S)
    return re.sub(r"//[^\n]*", " ", source)


def numbers(source, name):
    m = re.search(r"\b%s\s*\[[^\]]*\](?:\s*\[[^\]]*\])?\s*=\s*\{" % re.escape(name), source)
    if not m:
        sys.exit("no table %s" % name)
    depth, i = 1, m.end()
    while depth:
        depth += {"{": 1, "}": -1}.get(source[i], 0)
        i += 1
    body = source[m.end():i - 1]
    body = re.sub(r"L64\(([^)]*)\)", r"\1", body)
    vals = []
    for tok in re.findall(r"0[xX][0-9a-fA-F]+|\d+", body):
        vals.append(int(tok, 16) if tok.lower().startswith("0x") else int(tok))
    return vals


def render(name, typ, shape, vals):
    total = 1
    for d in shape:
        total *= d
    if len(vals) != total:
        sys.exit("table %s has %d values, expected %d" % (name, len(vals), total))
    wide = typ in ("u32", "u64")
    digits = {"u32": 8, "u64": 16}.get(typ, 0)
    per_line = {"u64": 4, "u32": 8}.get(typ, 16)

    def fmt(v):
        return "0x%0*x" % (digits, v) if wide else str(v)

    def rows(chunk, indent):
        lines = []
        for k in range(0, len(chunk), per_line):
            lines.append(indent + ", ".join(fmt(v) for v in chunk[k:k + per_line]) + ",")
        return lines

    zig_type = "".join("[%d]" % d for d in shape) + typ
    out = ["pub const %s: %s = .{" % (name, zig_type)]
    if len(shape) == 1:
        out += rows(vals, "    ")
    else:
        inner = shape[1]
        for r in range(shape[0]):
            out.append("    .{")
            out += rows(vals[r * inner:(r + 1) * inner], "        ")
            out.append("    },")
    out.append("};")
    return "\n".join(out)


def main():
    given = sys.argv[1] if len(sys.argv) > 1 else None
    version = target_version()
    src = {k: strip_comments(v) for k, v in sources(version, given).items()}
    parts = [
        "// generated by scripts/gen-hash-tables from php %s's ext/hash; do not edit" % version,
        "// the constant tables of php's hash algorithms (hash.zig)",
        "",
    ]
    for name, f, cname, typ, shape in TABLES:
        parts.append(render(name, typ, shape, numbers(src[f], cname)))
        parts.append("")
    with open(OUT, "w") as fh:
        fh.write("\n".join(parts))
    print("wrote " + OUT)


main()
