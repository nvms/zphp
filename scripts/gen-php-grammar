#!/usr/bin/env python3
# Regenerates src/pipeline/php_grammar_generated.zig: the LALR tables of php's
# own parser, which zphp runs over a script's tokens to word a syntax error
# exactly as php does (src/pipeline/php_syntax.zig).
#
# the tables come from Zend/zend_language_parser.c in the php release tarball
# for the version in src/php_version.zig (the git tag doesn't carry the
# generated parser). regenerate whenever that version moves:
#
#   make php-grammar
#
# pass a tarball or an unpacked source tree to skip the download:
#
#   scripts/gen-php-grammar ~/Downloads/php-8.5.12.tar.xz

import os, re, subprocess, sys, tarfile, tempfile, urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, "src", "pipeline", "php_grammar_generated.zig")


def target_version():
    text = open(os.path.join(REPO, "src", "php_version.zig")).read()
    parts = [re.search(r"pub const %s = (\d+);" % name, text).group(1) for name in ("major", "minor", "release")]
    return ".".join(parts)


def parser_source(version, given):
    member = "php-%s/Zend/zend_language_parser.c" % version
    if given and os.path.isdir(given):
        return open(os.path.join(given, "Zend", "zend_language_parser.c")).read()
    path = given
    if not path:
        path = os.path.join(tempfile.gettempdir(), "php-%s.tar.xz" % version)
        if not os.path.exists(path):
            url = "https://www.php.net/distributions/php-%s.tar.xz" % version
            print("downloading " + url, file=sys.stderr)
            urllib.request.urlretrieve(url, path)
    with tarfile.open(path) as tar:
        return tar.extractfile(member).read().decode()


def define(src, name):
    return int(re.search(r"#define %s +\(?(-?\d+)\)?" % name, src).group(1))


def table(src, name):
    body = re.search(r"static const \w+ %s\[\] =\s*\{(.*?)\};" % name, src, re.S).group(1)
    return [int(v) for v in re.findall(r"-?\d+", body)]


def names(src):
    body = re.search(r"static const char \*const yytname\[\] =\s*\{(.*?)\};", src, re.S).group(1)
    # bison splits "??" across adjacent literals to dodge trigraphs
    body = re.sub(r'(?<!\\)""', "", body)
    return [bytes(s, "utf-8").decode("unicode_escape") for s in re.findall(r'"((?:[^"\\]|\\.)*)"', body)]


def zig_ints(values):
    lines, line = [], ""
    for v in values:
        item = "%d, " % v
        if len(line) + len(item) > 96:
            lines.append("    " + line.rstrip())
            line = ""
        line += item
    if line:
        lines.append("    " + line.rstrip())
    return "\n".join(lines)


def zig_string(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main():
    version = target_version()
    src = parser_source(version, sys.argv[1] if len(sys.argv) > 1 else None)
    ntokens = define(src, "YYNTOKENS")
    tname = names(src)[:ntokens]
    out = ["// generated by scripts/gen-php-grammar from php %s's zend_language_parser.c; do not edit" % version, ""]
    for name in ("YYFINAL", "YYLAST", "YYNTOKENS", "YYMAXUTOK", "YYPACT_NINF", "YYTABLE_NINF"):
        out.append("pub const %s = %d;" % (name.lower()[2:], define(src, name)))
    out.append("")
    for name, kind in (("yytranslate", "u8"), ("yypact", "i16"), ("yydefact", "i16"), ("yypgoto", "i16"),
                       ("yydefgoto", "i16"), ("yytable", "i16"), ("yycheck", "i16"), ("yyr1", "i16"), ("yyr2", "u8")):
        out.append("pub const %s = [_]%s{\n%s\n};\n" % (name[2:], kind, zig_ints(table(src, name))))
    out.append("// the name of each terminal symbol, as bison declares it")
    out.append("pub const tname = [_][]const u8{")
    out.extend("    %s," % zig_string(n) for n in tname)
    out.append("};")
    with open(OUT, "w") as f:
        f.write("\n".join(out) + "\n")
    subprocess.run(["zig", "fmt", OUT], check=True, stdout=subprocess.DEVNULL)
    print("wrote " + os.path.relpath(OUT, REPO))


main()
