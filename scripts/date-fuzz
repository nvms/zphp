#!/usr/bin/env python3
# Differential fuzzing of the date string parser against php: generates random
# strings from the token families timelib's scanner knows, runs each through
# strtotime(), modify(), the constructor (zone and errors), and date_parse()
# under php and zphp, and prints the inputs whose output differs. with
# --formats it instead generates createFromFormat() formats and strings that
# mostly fit them, and compares date_parse_from_format() and createFromFormat().
#
#   scripts/date-fuzz [--formats] [--count N] [--seed S] [--zphp PATH] [--php CMD] [zone ...]
#
# --php is the reference command, split on spaces. to check against a newer php
# than the system one, run it in docker with the temp dir mounted at its own path:
#   TMPDIR=/tmp/df scripts/date-fuzz --php 'docker run --rm -v /tmp/df:/tmp/df php:8.5.12-cli php'
#
# zones default to America/New_York and Europe/Paris. exit status is 1 when
# any input differs.

import argparse
import os
import random
import shlex
import subprocess
import sys
import tempfile

POOL = [
    # numbers
    '1', '7', '12', '24', '25', '31', '60', '99', '100', '123', '1999', '2024', '20240315', '2024031', '240315',
    '123456', '1234567', '00', '09', '0', '366', '367', '+1', '-1', '+15', '-3', '++2', '--4', '+-5', '1e3',
    # separators
    ' ', '  ', '\t', '-', '/', '.', ':', ',', ';', '(', ')', 'T', 't', 'W', 'Z', 'z', '@', ' ', ' ',
    # months
    'jan', 'Feb', 'MARCH', 'april', 'may', 'Jun', 'july', 'aug', 'sep', 'sept', 'Oct', 'nov', 'December',
    'I', 'II', 'IV', 'VIII', 'XII', 'x',
    # days
    'mon', 'Tuesday', 'WED', 'thursday', 'fri', 'sat', 'sunday', 'mondays', 'weekday', 'weekdays',
    # relative words and units
    'next', 'last', 'previous', 'this', 'first', 'second', 'third', 'fifth', 'twelfth', 'eight', 'ago', 'of',
    'day', 'days', 'week', 'weeks', 'fortnight', 'month', 'months', 'year', 'years', 'hour', 'hours', 'min',
    'mins', 'minute', 'sec', 'secs', 'seconds', 'ms', 'msec', 'usec', 'µs', 'microsecond',
    'millisecond', 'now', 'today', 'tomorrow', 'yesterday', 'midnight', 'noon', 'back of', 'front of',
    'first day of', 'last day of',
    # meridians
    'am', 'pm', 'AM', 'P.M.', 'a.m.', 'p.m',
    # zones
    'UTC', 'utc', 'GMT', 'EST', 'EDT', 'CEST', 'cet', 'PST', 'A', 'Europe/Paris', 'America/New_York',
    'Asia/Tokyo', 'Mars/Base', '+0200', '-05:00', '+5', 'GMT+3', '-0330', '+05:30:15', '(UTC)',
    # whole formats
    '2024-03-15', '2024-3-5', '24-03-15', '03/15/2024', '3/5', '15.03.2024', '15.3.24', '2024/03/15',
    '15-Mar-2024', 'Mar-15-2024', '2024-Mar-15', '2024W11', '2024-W11-3', '2024.075',
    '10/Oct/2000:13:55:36 -0700', '20240315T101112', '2024-03-15T10:11:12.5+01:00', '10:11', '10:11:12',
    '10.11.12', '101112', '1011', 't1011', '10:11:12.123456', '10am', '10:30pm', '12am', '12:00 PM', '1:2:3',
    '23:59:60', '24:00', '5:6', '@1700000000', '@-86400', '@1700000000.5', '@1.', '1st', '2nd', '3rd', '21st',
]

DRIVER = r'''<?php
$zone = $argv[2];
date_default_timezone_set($zone);
$base = 1710000000 + 7 * 86400 * 5 + 3723;
$b = (new DateTimeImmutable('@' . $base))->setTimezone(new DateTimeZone($zone));
foreach (file($argv[1], FILE_IGNORE_NEW_LINES) as $s) {
    echo '[', $s, "]\n";
    $t = strtotime($s, $base);
    echo '  strtotime: ', $t === false ? 'false' : $t . ' ' . date('Y-m-d H:i:s T', $t), "\n";
    try {
        echo '  modify: ', $b->modify($s)->format('Y-m-d H:i:s.u T e'), "\n";
    } catch (DateMalformedStringException $e) {
        echo '  modify: ', $e->getMessage(), "\n";
    }
    try {
        $d = new DateTimeImmutable($s);
        echo '  construct: ', $d->getTimezone()->getName(), ' ', json_encode(DateTimeImmutable::getLastErrors()), "\n";
    } catch (DateMalformedStringException $e) {
        echo '  construct: ', $e->getMessage(), "\n";
    }
    echo '  parse: ', json_encode(date_parse($s)), "\n";
}
'''

FORMAT_DRIVER = r'''<?php
$zone = $argv[2];
date_default_timezone_set($zone);
foreach (file($argv[1], FILE_IGNORE_NEW_LINES) as $line) {
    [$f, $s] = json_decode($line);
    echo '[', $line, "]\n";
    echo '  parse: ', json_encode(date_parse_from_format($f, $s)), "\n";
    // without a reset, unset fields come from the clock, so only the zone is stable
    $fixed = strpbrk($f, '!|U') !== false;
    $d = DateTimeImmutable::createFromFormat($f, $s, strlen($s) % 2 ? new DateTimeZone('Asia/Kolkata') : null);
    echo '  create: ', $d === false ? 'false' : $d->format($fixed ? 'Y-m-d H:i:s.u T e U' : 'T e'), ' ', json_encode(DateTimeImmutable::getLastErrors()), "\n";
}
'''

DAYS = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday']
MONTHS = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december']
SEPS = ';:/.,-()'
NOISE = ['', ' ', 'x', '1', '12', '-', 'Mon', 'jan', '+', 'Z', 'am', '0', '999', '.', '  ', 'T', 'week']
SPECS = list('djDlSzmnMFYyxXaAgGhHisuveOPpTU!|+#?* -/:.,();') + ['\\T', 'Q', 'T']


def case(rng, word):
    return rng.choice([word, word.upper(), word.capitalize()])


def fmt_token(rng, c):
    r = rng.randint
    pick = rng.choice
    if c in 'dj':
        return pick(['%02d' % r(1, 31), str(r(1, 31)), '%02d' % r(0, 39)])
    if c == 'D':
        return case(rng, pick(DAYS)[:3])
    if c == 'l':
        return case(rng, pick(DAYS))
    if c == 'S':
        return pick(['st', 'nd', 'rd', 'th', 'TH', ''])
    if c == 'z':
        return str(r(0, 400))
    if c in 'mn':
        return pick(['%02d' % r(1, 12), str(r(1, 12)), str(r(0, 19))])
    if c == 'M':
        return case(rng, pick(MONTHS)[:3])
    if c == 'F':
        return case(rng, pick(MONTHS + ['sept', 'iv', 'xii']))
    if c == 'Y':
        return pick([str(r(1900, 2100)), str(r(0, 99999)), '%04d' % r(0, 9999)])
    if c == 'y':
        return pick(['%02d' % r(0, 99), str(r(0, 9)), str(r(100, 999))])
    if c in 'xX':
        return pick(['', '+', '-', '--']) + str(r(0, 10 ** r(1, 12)))
    if c in 'aA':
        return pick(['am', 'pm', 'AM', 'PM', 'a.m.', 'P.M.', 'p.m', 'a', 'x'])
    if c in 'gh':
        return pick([str(r(1, 12)), '%02d' % r(0, 19)])
    if c in 'GH':
        return pick([str(r(0, 23)), '%02d' % r(0, 29)])
    if c in 'is':
        return pick(['%02d' % r(0, 59), str(r(0, 9)), str(r(60, 99))])
    if c == 'u':
        return str(r(0, 10 ** r(1, 7)))
    if c == 'v':
        return str(r(0, 10 ** r(1, 4)))
    if c == 'e':
        return pick(['UTC', 'Europe/Paris', 'America/New_York', 'Asia/Tokyo', 'europe/paris', 'Mars/Base', '+05:30', 'EST', '(UTC)', 'GMT+3', 'Z'])
    if c in 'OPp':
        return pick(['+0200', '-05:00', '+5', 'Z', '+05:30:15', '-0330', '+14:00', '+99:00', 'GMT-1'])
    if c == 'T':
        return pick(['EST', 'EDT', 'CEST', 'cet', 'PST', 'UTC', 'A', 'XYZ', 'GMT'])
    if c == 'U':
        return pick(['', '-', '+']) + str(r(0, 10 ** r(1, 12)))
    if c == '#':
        return pick(list(SEPS) + [' '])
    if c == '?':
        return pick(['x', '1', ' ', '-', 'é'])
    if c == '*':
        return pick(['abc', 'x', '', 'Foo']) + pick(['', ' ', '-'])
    if c == ' ':
        return pick([' ', '', '\t', '  '])
    if c in SEPS:
        return c if r(0, 4) else pick(list(SEPS))
    if c.startswith('\\'):
        return c[1]
    if c in '!|+':
        return ''
    return c


def format_cases(rng, count):
    import json
    out = []
    for _ in range(count):
        specs = [rng.choice(SPECS) for _ in range(rng.randint(1, 7))]
        if rng.randint(0, 9) < 7:
            specs.insert(0, '!')
        f = ''.join(specs)
        s = ''
        for c in specs:
            s += fmt_token(rng, c) if rng.randint(0, 9) else rng.choice(NOISE)
        if rng.randint(0, 9) == 0:
            s += rng.choice(NOISE)
        out.append(json.dumps([f, s]))
    return out


def blocks(text):
    out = []
    for line in text.splitlines():
        if line.startswith('['):
            out.append([line])
        elif out:
            out[-1].append(line)
    return out


def main():
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    ap = argparse.ArgumentParser()
    ap.add_argument('--count', type=int, default=2000)
    ap.add_argument('--seed', type=int, default=1)
    ap.add_argument('--zphp', default=os.path.join(root, 'zig-out', 'bin', 'zphp'))
    ap.add_argument('--php', default='php')
    ap.add_argument('--formats', action='store_true')
    ap.add_argument('zones', nargs='*', default=['America/New_York', 'Europe/Paris'])
    args = ap.parse_args()

    rng = random.Random(args.seed)
    lines = format_cases(rng, args.count) if args.formats else []
    for _ in range(0 if args.formats else args.count):
        s = ''
        for _ in range(rng.randint(1, 6)):
            s += rng.choice(POOL)
            if rng.randint(0, 2) > 0:
                s += ' '
        lines.append(s)

    differing = 0
    with tempfile.TemporaryDirectory() as tmp:
        corpus = os.path.join(tmp, 'corpus.txt')
        driver = os.path.join(tmp, 'driver.php')
        with open(corpus, 'w', encoding='utf-8') as f:
            f.write('\n'.join(lines) + '\n')
        with open(driver, 'w') as f:
            f.write(FORMAT_DRIVER if args.formats else DRIVER)
        for zone in args.zones:
            php = subprocess.run(shlex.split(args.php) + [driver, corpus, zone], capture_output=True).stdout.decode('utf-8', 'replace')
            zphp = subprocess.run([args.zphp, 'run', driver, corpus, zone], capture_output=True).stdout.decode('utf-8', 'replace')
            for pb, zb in zip(blocks(php), blocks(zphp)):
                if pb != zb:
                    differing += 1
                    print(f'{zone} {pb[0]}')
                    for pl, zl in zip(pb[1:], zb[1:]):
                        if pl != zl:
                            print(f'  php:  {pl.strip()}')
                            print(f'  zphp: {zl.strip()}')
            if len(blocks(php)) != len(blocks(zphp)):
                differing += 1
                print(f'{zone}: php printed {len(blocks(php))} inputs, zphp {len(blocks(zphp))}')
    print(f'{differing} differing inputs ({args.count} strings, seed {args.seed}, zones {", ".join(args.zones)})')
    sys.exit(1 if differing else 0)


if __name__ == '__main__':
    main()
