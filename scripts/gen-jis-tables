#!/usr/bin/env python3
# Regenerates src/stdlib/jis_tables_generated.zig: the JIS X 0208 tables
# mbstring's Shift_JIS conversion reads (libmbfl's unicode_table_jis.h and the
# Shift_JIS decode tables in mbfilter_cjk.c), from the php release tarball
# for the version in src/php_version.zig. regenerate whenever that version
# moves:
#
#   make jis-tables
#
# pass a tarball or an unpacked source tree to skip the download:
#
#   scripts/gen-jis-tables ~/Downloads/php-8.5.12.tar.xz

import os, re, sys, tarfile, tempfile, urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, "src", "stdlib", "jis_tables_generated.zig")
FILES = [
    "ext/mbstring/libmbfl/filters/unicode_table_jis.h",
    "ext/mbstring/libmbfl/filters/mbfilter_cjk.c",
]

# (zig name, file, c array name): u16 tables; negative entries wrap as in C
TABLES = [
    ("jisx0208_ucs", "unicode_table_jis.h", "jisx0208_ucs_table"),
    ("ucs_a1_jis", "unicode_table_jis.h", "ucs_a1_jis_table"),
    ("ucs_a2_jis", "unicode_table_jis.h", "ucs_a2_jis_table"),
    ("ucs_i_jis", "unicode_table_jis.h", "ucs_i_jis_table"),
    ("ucs_r_jis", "unicode_table_jis.h", "ucs_r_jis_table"),
    ("sjis_decode1", "mbfilter_cjk.c", "sjis_decode_tbl1"),
    ("sjis_decode2", "mbfilter_cjk.c", "sjis_decode_tbl2"),
]

# where each ucs_*_jis table starts (its _min constant)
STARTS = [
    ("ucs_a1_jis_min", "unicode_table_jis.h", "ucs_a1_jis_table_min"),
    ("ucs_a2_jis_min", "unicode_table_jis.h", "ucs_a2_jis_table_min"),
    ("ucs_i_jis_min", "unicode_table_jis.h", "ucs_i_jis_table_min"),
    ("ucs_r_jis_min", "unicode_table_jis.h", "ucs_r_jis_table_min"),
]


def target_version():
    text = open(os.path.join(REPO, "src", "php_version.zig")).read()
    parts = [re.search(r"pub const %s = (\d+);" % name, text).group(1) for name in ("major", "minor", "release")]
    return ".".join(parts)


def sources(version, given):
    out = {}
    if given and os.path.isdir(given):
        for member in FILES:
            out[os.path.basename(member)] = open(os.path.join(given, member)).read()
        return out
    path = given
    if not path:
        path = os.path.join(tempfile.gettempdir(), "php-%s.tar.xz" % version)
        if not os.path.exists(path):
            url = "https://www.php.net/distributions/php-%s.tar.xz" % version
            print("downloading " + url, file=sys.stderr)
            urllib.request.urlretrieve(url, path)
    with tarfile.open(path) as tar:
        for member in tar.getmembers():
            for wanted in FILES:
                if member.name.endswith("/" + wanted):
                    out[os.path.basename(wanted)] = tar.extractfile(member).read().decode()
    missing = [f for f in FILES if os.path.basename(f) not in out]
    if missing:
        sys.exit("missing in %s: %s" % (path, ", ".join(missing)))
    return out


def strip_comments(source):
    source = re.sub(r"/\*.*?\*/", " ", source, flags=re.S)
    return re.sub(r"//[^\n]*", " ", source)


def numbers(source, name):
    m = re.search(r"\b%s\s*\[[^\]]*\]\s*=\s*\{" % re.escape(name), source)
    if not m:
        sys.exit("no table %s" % name)
    end = source.index("}", m.end())
    vals = []
    for tok in re.findall(r"-?0[xX][0-9a-fA-F]+|-?\d+", source[m.end():end]):
        neg = tok.startswith("-")
        tok = tok.lstrip("-")
        v = int(tok, 16) if tok.lower().startswith("0x") else int(tok)
        vals.append((-v if neg else v) & 0xFFFF)
    return vals


def constant(source, name):
    m = re.search(r"\b%s\s*=\s*(0[xX][0-9a-fA-F]+|\d+)\s*;" % re.escape(name), source)
    if not m:
        sys.exit("no constant %s" % name)
    return int(m.group(1), 0)


def render(name, vals):
    out = ["pub const %s = [%d]u16{" % (name, len(vals))]
    for k in range(0, len(vals), 12):
        out.append("    " + ", ".join("0x%04x" % v for v in vals[k:k + 12]) + ",")
    out.append("};")
    return "\n".join(out)


def main():
    given = sys.argv[1] if len(sys.argv) > 1 else None
    version = target_version()
    src = {k: strip_comments(v) for k, v in sources(version, given).items()}
    parts = [
        "// generated by scripts/gen-jis-tables from php %s's ext/mbstring; do not edit" % version,
        "// the JIS X 0208 tables of mbstring's Shift_JIS conversion (sjis.zig)",
        "",
    ]
    for name, f, cname in STARTS:
        parts.append("pub const %s: u21 = 0x%04x;" % (name, constant(src[f], cname)))
    parts.append("")
    for name, f, cname in TABLES:
        parts.append(render(name, numbers(src[f], cname)))
        parts.append("")
    with open(OUT, "w") as fh:
        fh.write("\n".join(parts))
    print("wrote " + OUT)


main()
