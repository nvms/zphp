#!/usr/bin/env python3
# Regenerates src/stdlib/intlchar_constants_generated.h: IntlChar's class
# constants, in php's declaration order, as the ICU macros and enum values
# php registers them with (ext/intl/uchar/uchar_arginfo.h of the php release
# for the version in src/php_version.zig). icu_shim.c includes it, so the C
# compiler evaluates every value against the ICU zphp links, as php's build
# does, and the version guards php puts around newer constants apply too.
# regenerate whenever that version moves:
#
#   make php-intlchar
#
# pass a tarball or an unpacked source tree to skip the download:
#
#   scripts/gen-intlchar-constants ~/Downloads/php-8.6.0.tar.xz

import os, re, sys, tarfile, tempfile, urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, "src", "stdlib", "intlchar_constants_generated.h")
MEMBER = "ext/intl/uchar/uchar_arginfo.h"


def target_version():
    text = open(os.path.join(REPO, "src", "php_version.zig")).read()
    parts = [re.search(r"pub const %s = (\d+);" % name, text).group(1) for name in ("major", "minor", "release")]
    return ".".join(parts)


def arginfo(version, given):
    if given and os.path.isdir(given):
        return open(os.path.join(given, MEMBER)).read()
    path = given
    if not path:
        path = os.path.join(tempfile.gettempdir(), "php-%s.tar.xz" % version)
        if not os.path.exists(path):
            url = "https://www.php.net/distributions/php-%s.tar.xz" % version
            print("downloading " + url, file=sys.stderr)
            urllib.request.urlretrieve(url, path)
    with tarfile.open(path) as tar:
        for member in tar.getmembers():
            if member.name.endswith("/" + MEMBER):
                return tar.extractfile(member).read().decode()
    sys.exit("no %s in %s" % (MEMBER, path))


def main():
    version = target_version()
    text = arginfo(version, sys.argv[1] if len(sys.argv) > 1 else None)
    body = text[text.index("static zend_class_entry *register_class_IntlChar"):]
    lines = [
        "/* generated by scripts/gen-intlchar-constants from php %s's %s; do not edit */" % (version, MEMBER),
        "",
        "/* kind: 0 int, 1 float, 2 string */",
        "static const struct zphp_intlchar_constant zphp_intlchar_constants[] = {",
    ]
    count = 0
    for line in body.split("\n"):
        stripped = line.strip()
        if stripped.startswith("#if") or stripped.startswith("#endif") or stripped.startswith("#else"):
            lines.append(stripped)
            continue
        m = re.match(r"ZVAL_(LONG|DOUBLE)\(&const_(\w+)_value, (.+)\);$", stripped)
        if m:
            kind = 0 if m.group(1) == "LONG" else 1
            lines.append('    { "%s", %d, (int64_t)(%s), (double)(%s), 0 },' % (m.group(2), kind, m.group(3), m.group(3)))
            count += 1
            continue
        m = re.match(r"zend_string \*const_(\w+)_value_str = zend_string_init\((\w+), ", stripped)
        if m:
            lines.append('    { "%s", 2, 0, 0, %s },' % (m.group(1), m.group(2)))
            count += 1
    lines.append("};")
    with open(OUT, "w") as f:
        f.write("\n".join(lines) + "\n")
    print("%d constants" % count)


main()
