#!/usr/bin/env python3
# Regenerates src/stdlib/method_order_generated.zig: the methods each internal
# class, interface, trait and enum declares, in the order its *.stub.php
# declares them. php's function table follows that order, so reflection
# (getMethods, __toString) and get_class_methods list a built-in class's
# methods in it.
#
# the stubs come from the php release tarball for the version in
# src/php_version.zig. regenerate whenever that version moves:
#
#   make php-method-order
#
# pass a tarball or an unpacked source tree to skip the download:
#
#   scripts/gen-php-method-order ~/Downloads/php-8.6.0.tar.xz

import os, re, sys, tarfile, tempfile, urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, "src", "stdlib", "method_order_generated.zig")


def target_version():
    text = open(os.path.join(REPO, "src", "php_version.zig")).read()
    parts = [re.search(r"pub const %s = (\d+);" % name, text).group(1) for name in ("major", "minor", "release")]
    return ".".join(parts)


def stubs(version, given):
    if given and os.path.isdir(given):
        for root, _, files in os.walk(given):
            for name in sorted(files):
                if name.endswith(".stub.php") and "/tests/" not in os.path.join(root, name) and "/zend_test/" not in root:
                    path = os.path.join(root, name)
                    yield os.path.relpath(path, given), open(path).read()
        return
    path = given
    if not path:
        path = os.path.join(tempfile.gettempdir(), "php-%s.tar.xz" % version)
        if not os.path.exists(path):
            url = "https://www.php.net/distributions/php-%s.tar.xz" % version
            print("downloading " + url, file=sys.stderr)
            urllib.request.urlretrieve(url, path)
    with tarfile.open(path) as tar:
        for member in sorted(tar.getmembers(), key=lambda m: m.name):
            if not member.name.endswith(".stub.php"):
                continue
            # php's own test extension is not part of a php build
            if "/ext/zend_test/" in member.name or "/tests/" in member.name:
                continue
            yield member.name, tar.extractfile(member).read().decode()


def strip_comments(source):
    source = re.sub(r"/\*.*?\*/", lambda m: "\n" * m.group(0).count("\n"), source, flags=re.S)
    return re.sub(r"(?m)//.*$", "", source)


def scan(source, found):
    namespace = ""
    scope = None
    scope_depth = 0
    depth = 0
    text = strip_comments(source)
    for m in re.finditer(r"\bnamespace\b\s*([\w\\]*)\s*(?=[;{])|(?:(?:abstract|final|readonly)\s+)*\b(class|interface|trait|enum)\s+(\w+)|\bfunction\s+(\w+)\s*\(|[{}]", text):
        tok = m.group(0)
        if tok.startswith("namespace"):
            namespace = m.group(1)
        elif m.group(2) and scope is None:
            scope = (namespace + "\\" if namespace else "") + m.group(3)
            scope_depth = depth
            found.setdefault(scope, [])
        elif m.group(4):
            if scope is not None and m.group(4) not in found[scope]:
                found[scope].append(m.group(4))
        elif tok == "{":
            depth += 1
        elif tok == "}":
            depth -= 1
            if scope is not None and depth <= scope_depth:
                scope = None


def zig_string(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main():
    version = target_version()
    found = {}
    for _, source in stubs(version, sys.argv[1] if len(sys.argv) > 1 else None):
        scan(source, found)
    lines = [
        "// generated by scripts/gen-php-method-order from php %s's stubs; do not edit" % version,
        "// the methods each internal class declares, in declaration order",
        "",
        'const std = @import("std");',
        "",
        "pub const orders = std.StaticStringMap([]const []const u8).initComptime(.{",
    ]
    for scope in sorted(found, key=str.lower):
        methods = found[scope]
        if not methods:
            continue
        items = ", ".join(zig_string(m) for m in methods)
        # zig fmt's spacing: none inside the braces of a single element
        body = items if len(methods) == 1 else " " + items + " "
        lines.append("    .{ %s, &[_][]const u8{%s} }," % (zig_string(scope.lower()), body))
    lines.append("});")
    lines.append("")
    with open(OUT, "w") as f:
        f.write("\n".join(lines))
    print("wrote %s (%d classes)" % (OUT, sum(1 for s in found if found[s])))


main()
