#!/usr/bin/env python3
# Regenerates what zphp takes from php's own reflection for the natives and
# classes the two share:
#
#   src/stdlib/native_params_generated.zig    the signature of every native
#       function and method: parameter names, types, defaults, which are
#       required, by reference, or variadic, and the return type. named
#       arguments to natives are placed by it and reflection reports it
#   src/stdlib/serialization_generated.zig    the internal classes php refuses
#       to serialize, and whether a subclass may opt back in by implementing
#       __serialize/__unserialize
#   src/stdlib/tokens_generated.zig    the tokenizer's T_* constants and the
#       name token_name() gives each id
#
# the native and class lists come from the running zphp binary, so they always
# match the build; the metadata comes from php, so run this with the php version
# zphp targets on PATH and regenerate after adding natives or classes:
#
#   make php-metadata
#
# natives and classes php does not have (the Zphp namespace) are written by hand
# in src/stdlib/native_params.zig and src/stdlib/serialize.zig.
#
#   src/stdlib/interface_signatures_generated.zig    the methods of every
#       internal interface zphp declares, for the inheritance checks a class
#       implementing one goes through. `scripts/gen-php-metadata --interfaces`
#       writes only this file, which needs no extension php may lack

import base64, json, os, subprocess, sys, tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ZPHP = os.environ.get("ZPHP", os.path.join(REPO, "zig-out", "bin", "zphp"))
PARAMS_OUT = os.path.join(REPO, "src", "stdlib", "native_params_generated.zig")
SERIALIZATION_OUT = os.path.join(REPO, "src", "stdlib", "serialization_generated.zig")
TOKENS_OUT = os.path.join(REPO, "src", "stdlib", "tokens_generated.zig")
INTERFACES_OUT = os.path.join(REPO, "src", "stdlib", "interface_signatures_generated.zig")

TOKENS = r'''<?php
$out = [];
foreach (get_defined_constants(true)['tokenizer'] as $name => $id) {
    if (str_starts_with($name, 'T_')) $out[] = [$name, $id, token_name($id)];
}
echo json_encode($out);
'''

INTERFACE_LIST = "<?php foreach (get_declared_interfaces() as $i) if ((new ReflectionClass($i))->isInternal()) echo $i, \"\\n\";"

INTERFACE_METHODS = r'''<?php
foreach (explode("\n", trim(stream_get_contents(STDIN))) as $iface) {
    if (!interface_exists($iface)) continue;
    foreach ((new ReflectionClass($iface))->getMethods() as $m) {
        if ($m->getDeclaringClass()->getName() === $iface) echo $iface, "::", $m->getName(), "\n";
    }
}
'''

LIST = "<?php foreach (get_defined_functions()['internal'] as $f) echo $f, \"\\n\";"
CLASSES = "<?php foreach (array_merge(get_declared_classes(), get_declared_interfaces()) as $c) echo $c, \"\\n\";"

# unserializing an empty instance is how php reveals the not-serializable flag
# without constructing anything; the dom classes carry their own wording
SERIALIZATION = r'''<?php
$out = [];
foreach (explode("\n", trim(stream_get_contents(STDIN))) as $class) {
    if (!class_exists($class) && !interface_exists($class)) continue;
    if (!(new ReflectionClass($class))->isInternal()) continue;
    try {
        @unserialize(sprintf('O:%d:"%s":0:{}', strlen($class), $class));
    } catch (Throwable $e) {
        $message = $e->getMessage();
        if (!str_contains($message, 'is not allowed')) continue;
        $out[$class] = str_contains($message, 'unless') ? 'unless_methods' : 'always';
    }
}
echo json_encode($out);
'''

REFLECT = r'''<?php
$out = [];
foreach (explode("\n", trim(stream_get_contents(STDIN))) as $name) {
    try {
        if (str_contains($name, '::')) {
            [$class, $method] = explode('::', $name, 2);
            if (!class_exists($class) && !interface_exists($class) && !enum_exists($class)) continue;
            if (!method_exists($class, $method)) continue;
            $r = new ReflectionMethod($class, $method);
        } else {
            if (!function_exists($name)) continue;
            $r = new ReflectionFunction($name);
        }
    } catch (Throwable) {
        continue;
    }
    $params = [];
    foreach ($r->getParameters() as $p) {
        $param = [
            'name' => $p->getName(),
            'variadic' => $p->isVariadic(),
            'by_ref' => $p->isPassedByReference(),
            'type' => $p->hasType() ? (string) $p->getType() : '',
            'constant' => '',
        ];
        if (!$p->isOptional()) {
            $param['default'] = ['kind' => 'required'];
        } elseif (!$p->isDefaultValueAvailable()) {
            $param['default'] = ['kind' => 'unknown'];
        } else {
            $v = $p->getDefaultValue();
            if ($p->isDefaultValueConstant()) $param['constant'] = $p->getDefaultValueConstantName();
            $param['default'] = match (true) {
                $v === null => ['kind' => 'null'],
                is_bool($v) => ['kind' => 'bool', 'value' => $v],
                is_int($v) => ['kind' => 'int', 'value' => $v],
                is_float($v) => ['kind' => 'float', 'value' => is_nan($v) ? 'nan' : (is_infinite($v) ? ($v > 0 ? 'inf' : '-inf') : $v)],
                is_string($v) => ['kind' => 'string', 'value' => base64_encode($v)],
                $v === [] => ['kind' => 'empty_array'],
                $v instanceof UnitEnum => ['kind' => 'class_constant', 'class' => get_class($v), 'name' => $v->name],
                default => ['kind' => 'unknown'],
            };
        }
        $params[] = $param;
    }
    $out[$name] = [
        'static' => $r instanceof ReflectionMethod && $r->isStatic(),
        'params' => $params,
        'returns' => $r->hasReturnType() ? (string) $r->getReturnType() : '',
        'tentative' => $r->hasTentativeReturnType() ? (string) $r->getTentativeReturnType() : '',
    ];
}
echo json_encode($out, JSON_PRESERVE_ZERO_FRACTION);
'''


def zig_string(raw: bytes) -> str:
    parts = []
    for b in raw:
        c = chr(b)
        if c == '"' or c == "\\":
            parts.append("\\" + c)
        elif 32 <= b < 127:
            parts.append(c)
        else:
            parts.append("\\x%02x" % b)
    return '"' + "".join(parts) + '"'


def zig_float(v) -> str:
    if v == "nan":
        return "std.math.nan(f64)"
    if v == "inf":
        return "std.math.inf(f64)"
    if v == "-inf":
        return "-std.math.inf(f64)"
    text = repr(float(v))
    return text if ("." in text or "e" in text) else text + ".0"


def zig_default(d) -> str:
    kind = d["kind"]
    if kind in ("required", "unknown", "null", "empty_array"):
        return "." + kind
    if kind == "bool":
        return ".{ .bool = %s }" % ("true" if d["value"] else "false")
    if kind == "int":
        return ".{ .int = %d }" % d["value"]
    if kind == "float":
        return ".{ .float = %s }" % zig_float(d["value"])
    if kind == "string":
        return ".{ .string = %s }" % zig_string(base64.b64decode(d["value"]))
    if kind == "class_constant":
        return ".{ .class_constant = .{ .class = %s, .name = %s } }" % (zig_string(d["class"].encode()), zig_string(d["name"].encode()))
    raise ValueError(kind)


def zig_param(p) -> str:
    fields = [".name = %s" % zig_string(p["name"].encode())]
    if p["default"]["kind"] != "required":
        fields.append(".default = %s" % zig_default(p["default"]))
    if p["variadic"]:
        fields.append(".variadic = true")
    if p["by_ref"]:
        fields.append(".by_ref = true")
    if p["type"]:
        fields.append(".type = %s" % zig_string(p["type"].encode()))
    if p["constant"]:
        fields.append(".default_constant = %s" % zig_string(p["constant"].encode()))
    return ".{ " + ", ".join(fields) + " }"


def zig_signature(sig) -> str:
    body = ", ".join(zig_param(p) for p in sig["params"])
    fields = [".params = &[_]Param{%s}" % ((" " + body + " ") if body else "")]
    if sig["returns"]:
        fields.append(".returns = %s" % zig_string(sig["returns"].encode()))
    if sig["tentative"]:
        fields.append(".tentative_returns = %s" % zig_string(sig["tentative"].encode()))
    if sig.get("static"):
        fields.append(".is_static = true")
    return "Signature{ " + ", ".join(fields) + " }"


def run_script(binary, source, stdin=""):
    with tempfile.NamedTemporaryFile("w", suffix=".php", delete=False) as f:
        f.write(source)
    try:
        args = [binary, "run", f.name] if binary == ZPHP else [binary, "-d", "error_reporting=0", f.name]
        return subprocess.run(args, input=stdin, capture_output=True, text=True, check=True).stdout
    finally:
        os.unlink(f.name)


def write_interfaces():
    interfaces = run_script(ZPHP, INTERFACE_LIST)
    methods = run_script("php", INTERFACE_METHODS, interfaces)
    signatures = json.loads(run_script("php", REFLECT, methods) or "{}")
    version = subprocess.run(["php", "-r", "echo PHP_VERSION;"], capture_output=True, text=True, check=True).stdout
    lines = [
        "// generated by scripts/gen-php-metadata --interfaces from php %s reflection; do not edit" % version,
        "const std = @import(\"std\");",
        "const native_params = @import(\"native_params.zig\");",
        "const Param = native_params.Param;",
        "const Signature = native_params.Signature;",
        "",
        "pub const map = std.StaticStringMap(Signature).initComptime(.{",
    ]
    for name in sorted(signatures):
        lines.append("    .{ %s, %s }," % (zig_string(name.encode()), zig_signature(signatures[name])))
    lines.append("});")
    with open(INTERFACES_OUT, "w") as f:
        f.write("\n".join(lines) + "\n")
    print("%d interface methods" % len(signatures))


def main():
    if "--interfaces" in sys.argv[1:]:
        return write_interfaces()
    names = run_script(ZPHP, LIST)
    signatures = json.loads(run_script("php", REFLECT, names))
    version = subprocess.run(["php", "-r", "echo PHP_VERSION;"], capture_output=True, text=True, check=True).stdout

    header = "// generated by scripts/gen-php-metadata from php %s reflection; do not edit" % version
    lines = [
        header,
        "const std = @import(\"std\");",
        "const native_params = @import(\"native_params.zig\");",
        "const Param = native_params.Param;",
        "const Signature = native_params.Signature;",
        "",
        "pub const map = std.StaticStringMap(Signature).initComptime(.{",
    ]
    for name in sorted(signatures):
        lines.append("    .{ %s, %s }," % (zig_string(name.encode()), zig_signature(signatures[name])))
    lines.append("});")
    with open(PARAMS_OUT, "w") as f:
        f.write("\n".join(lines) + "\n")

    classes = run_script(ZPHP, CLASSES)
    rules = json.loads(run_script("php", SERIALIZATION, classes) or "{}")
    lines = [
        header,
        "const std = @import(\"std\");",
        "const Rule = @import(\"serialize.zig\").NotSerializable;",
        "",
        "pub const classes = std.StaticStringMap(Rule).initComptime(.{",
    ]
    for name in sorted(rules):
        lines.append("    .{ %s, Rule.%s }," % (zig_string(name.encode()), rules[name]))
    lines.append("});")
    with open(SERIALIZATION_OUT, "w") as f:
        f.write("\n".join(lines) + "\n")

    tokens = json.loads(run_script("php", TOKENS))
    lines = [
        header,
        "pub const Constant = struct { name: []const u8, id: i64 };",
        "",
        "// every T_* constant, aliases included",
        "pub const constants = [_]Constant{",
    ]
    for name, tid, _ in tokens:
        lines.append("    .{ .name = \"%s\", .id = %d }," % (name, tid))
    lines += ["};", "", "// token_name(): the canonical name of each id", "pub const names = [_]Constant{"]
    seen = set()
    for _, tid, canonical in sorted(tokens, key=lambda t: t[1]):
        if tid in seen: continue
        seen.add(tid)
        lines.append("    .{ .name = \"%s\", .id = %d }," % (canonical, tid))
    lines.append("};")
    lines.append("")
    for name, tid, _ in tokens:
        lines.append("pub const %s: i64 = %d;" % (name, tid))
    with open(TOKENS_OUT, "w") as f:
        f.write("\n".join(lines) + "\n")
    print("%d natives, %d not-serializable classes, %d token constants" % (len(signatures), len(rules), len(tokens)))


if __name__ == "__main__":
    main()
