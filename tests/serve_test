check "app health still the application's" '{"status":"ok"}' "$(curl -s http://localhost:$OBS_PORT/health)"

# request ids on one keep-alive connection: each request gets its own
rid_result=$(python3 - "$OBS_PORT" <<'PY'
import re, socket, sys
s = socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=10)
def request(rid):
    head = "GET /request-id HTTP/1.1\r\nHost: x\r\n" + ("" if rid is None else "X-Request-Id: " + rid + "\r\n") + "\r\n"
    s.sendall(head.encode("latin-1"))
    data = b""
    while b"\r\n\r\n" not in data:
        data += s.recv(65536)
    hdr, body = data.split(b"\r\n\r\n", 1)
    n = int(re.search(rb"(?im)^content-length:\s*(\d+)", hdr).group(1))
    while len(body) < n:
        body += s.recv(65536)
    m = re.search(rb"(?im)^x-request-id: ([^\r]*)", hdr)
    return (m.group(1).decode() if m else "-"), body[:n].decode()
ids = [request("client-1"), request(None), request("x" * 65), request("bad id\x01"), request("client-2")]
hexid = re.compile(r"^[0-9a-f]{32}$")
print("given=" + ("ok" if ids[0] == ("client-1", "client-1") and ids[4] == ("client-2", "client-2") else repr(ids)))
gen = ids[1:4]
print("generated=" + ("ok" if all(h == b and hexid.match(h) for h, b in gen) else repr(gen)))
print("unique=" + ("ok" if len({h for h, _ in gen}) == 3 else repr(gen)))
PY
)
check_contains "incoming request ids kept per request" "given=ok" "$rid_result"
check_contains "missing and invalid ids replaced" "generated=ok" "$rid_result"
check_contains "generated ids unique on keep-alive" "unique=ok" "$rid_result"
check_contains "static files carry the id" "X-Request-Id: static-1" "$(curl -si -H 'X-Request-Id: static-1' http://localhost:$OBS_PORT/style.css | tr -d '\r')"
check "uncaught exception still 500" "500" "$(curl -s -o /dev/null -w '%{http_code}' -H 'X-Request-Id: boom-1' http://localhost:$OBS_PORT/uncaught)"
check "malformed request still 400" "HTTP/1.1 400 Bad Request" "$(PORT=$OBS_PORT hostile 'POST /reject HTTP/1.1\r\nHost: x\r\nX-Request-Id: reject-1\r\nContent-Length: -1\r\n\r\n')"
PORT=$OBS_PORT hostile 'GET /esc"\x01\\\xff HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n' > /dev/null || true
curl -s -o /dev/null -H "Authorization: Bearer topsecret-auth" -H "Cookie: session=topsecret-cookie" "http://localhost:$OBS_PORT/echo?token=topsecret-query"

# admin keeps answering while workers are busy, and active requests show
slow_pids=""
for i in 1 2; do curl -s -o /dev/null "http://localhost:$OBS_PORT/slow?ms=1500" & slow_pids="$slow_pids $!"; done
sleep 0.5
check "admin health while workers are busy" "ok" "$(curl -s -m 1 http://127.0.0.1:$OBS_ADMIN/health)"
