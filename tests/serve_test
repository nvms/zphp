check "log file mode leaves stdout empty" "" "$(cat "$OBS_DIR/obs.out")"

log_result=$(python3 - "$(native_path "$OBS_LOG")" "$OBS_ADMIN" "$is_windows" <<'PY'
import json, sys
path, admin, windows = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
raw = open(path, "rb").read()
out = []
try:
    lines = [json.loads(l) for l in raw.decode("utf-8").splitlines()]
    out.append("json=ok")
except Exception as e:
    print("json=" + repr(e)); sys.exit()
access = [l for l in lines if l.get("component") == "access"]
fields = {"ts", "level", "component", "msg", "request_id", "worker", "method", "path", "protocol", "status", "bytes", "duration_ms", "remote_addr"}
out.append("fields=" + ("ok" if access and all(fields <= set(l) for l in access) else "missing"))
out.append("count=%d" % len(access))
out.append("workers=%d" % len({l["worker"] for l in access}))
start = [l for l in lines if l.get("msg") == "server started"]
out.append("startup=" + ("ok" if start and start[0].get("admin") == "127.0.0.1:" + admin and start[0].get("workers") == 4 else repr(start)))
err = [l for l in lines if l.get("component") == "php" and l.get("request_id") == "boom-1"]
out.append("exception=" + ("ok" if err and err[0].get("exception") == "RuntimeException" and err[0].get("message") == "boom" else repr(err)))
boom = [l for l in access if l["request_id"] == "boom-1"]
out.append("exception_access=" + ("ok" if boom and boom[0]["status"] == 500 else repr(boom)))
rej = [l for l in access if l["request_id"] == "reject-1"]
out.append("rejected=" + ("ok" if rej and rej[0]["status"] == 400 and rej[0]["path"] == "/reject" else repr(rej)))
esc = [l for l in access if l["path"].startswith("/esc")]
out.append("escaped=" + ("ok" if esc and esc[0]["path"] == '/esc"\x01\\�' else repr(esc)))
out.append("secrets=" + ("leaked" if b"topsecret" in raw else "ok"))
stops = [l["msg"] for l in lines if l.get("component") == "server"]
out.append("shutdown=" + ("ok" if windows or stops[-2:] == ["shutting down", "server stopped"] else repr(stops)))
print(" ".join(out))
PY
)
for k in json=ok fields=ok startup=ok exception=ok exception_access=ok rejected=ok escaped=ok secrets=ok shutdown=ok; do
    check_contains "log ${k%%=*}" "$k" "$log_result"
