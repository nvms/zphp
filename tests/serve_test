check "connections all closed" "0" "$(wait_metric zphp_connections_active 0)"

kill -TERM $OBS_PID 2>/dev/null || true
obs_exit=0
wait $OBS_PID 2>/dev/null || obs_exit=$?
OBS_PID=
if [ $obs_exit -eq 0 ] || [ $obs_exit -eq 143 ]; then pass "observability server shuts down"; else fail "observability server shuts down" "exit $obs_exit"; fi
