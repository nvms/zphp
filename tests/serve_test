    out=$(limited "$ZPHP" serve "$APP" --port $OBS_PORT "$@" 2>&1 >/dev/null) || st=$?
    if [ "$st" -eq 1 ] && echo "$out" | grep -q -- "$needle"; then pass "$name"; else fail "$name" "exit $st, got: $out"; fi
}
