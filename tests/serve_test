# --- observability: admin listener, metrics, access logs, request ids ---
OBS_PORT=$((PORT + 40))
OBS_ADMIN=$((PORT + 41))
OBS_DIR=$(mktemp -d /tmp/zphp_obs.XXXXXX)
is_windows=0
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) is_windows=1 ;; esac
# zphp is a native program under msys2 and needs the windows spelling
native_path() { if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else echo "$1"; fi; }
limited() { if command -v timeout >/dev/null 2>&1; then timeout 20 "$@"; else "$@"; fi; }
pass() { passed=$((passed + 1)); echo "  pass  $1"; }
fail() { failed=$((failed + 1)); echo "  FAIL  $1"; errors="$errors${nl}--- $1 ---${nl}$2${nl}"; }
check_absent() {
    if echo "$3" | grep -qi -- "$2"; then fail "$1" "expected no: $2${nl}got: $3"; else pass "$1"; fi
}
wait_ready() {
    for i in $(seq 1 100); do
        [ "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$1/ready")" = "200" ] && return 0
        sleep 0.1
    done
    return 1
}
metric_value() { curl -s "http://127.0.0.1:$OBS_ADMIN/metrics" | awk -v m="$1" '$1 == m {print $2}'; }
# counters update right after the response is written, so poll briefly
wait_metric() {
    local v=""
    for i in $(seq 1 50); do
        v=$(metric_value "$1")
        [ "$v" = "$2" ] && break
        sleep 0.05
    done
    echo "$v"
}

