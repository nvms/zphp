#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ZPHP="${ZPHP:-$SCRIPT_DIR/../../zig-out/bin/zphp}"
APP_DIR="$SCRIPT_DIR/app"

if ! command -v php &>/dev/null; then
    echo "php not found in PATH"
    exit 1
fi

if [ ! -f "$ZPHP" ]; then
    echo "zphp not found at $ZPHP (build with: make build)"
    exit 1
fi

if [ ! -d "$APP_DIR/vendor" ]; then
    echo "run 'tests/laravel/setup' first"
    exit 1
fi

# ensure sqlite database exists
touch "$APP_DIR/database/database.sqlite"
mkdir -p "$APP_DIR/storage/framework/views"

passed=0
failed=0
errors=""

for f in "$SCRIPT_DIR"/harness/test-*.php; do
    name="$(basename "$f" .php)"
    php_start=$SECONDS
    php_out="$(php -d error_reporting=E_ALL\&~E_DEPRECATED\&~E_WARNING "$f" 2>&1)" && php_exit=0 || php_exit=$?
    php_secs=$((SECONDS - php_start))
    # a Debug build of the blade harness takes about 110s on the ci runner,
    # so the limit only has to catch a hang, not pace the slowest test
    TIMEOUT_CMD=""
    if command -v timeout &>/dev/null; then
        TIMEOUT_CMD="timeout 300"
    elif command -v gtimeout &>/dev/null; then
        TIMEOUT_CMD="gtimeout 300"
    fi
    zphp_start=$SECONDS
    zphp_out="$($TIMEOUT_CMD "$ZPHP" run "$f" 2>&1)" && zphp_exit=0 || zphp_exit=$?
    zphp_secs=$((SECONDS - zphp_start))

    if [ "$php_exit" -eq 0 ] && [ "$zphp_exit" -eq 0 ] && [ "$php_out" = "$zphp_out" ]; then
        passed=$((passed + 1))
        echo "  pass  $name (php ${php_secs}s, zphp ${zphp_secs}s)"
    else
        failed=$((failed + 1))
        if [ $php_exit -ne 0 ]; then
            echo "  FAIL  $name (php exit $php_exit, zphp exit $zphp_exit)"
        elif [ $zphp_exit -eq 124 ]; then
            echo "  FAIL  $name (timeout)"
        elif [ $zphp_exit -ne 0 ]; then
            echo "  FAIL  $name (exit $zphp_exit)"
        else
            echo "  FAIL  $name"
        fi
        errors="$errors\n--- $name ---\nexpected (php):\n$php_out\ngot (zphp):\n$zphp_out\n"
    fi
done

echo ""
echo "$passed passed, $failed failed"

if [ $failed -gt 0 ]; then
    echo -e "$errors"
    exit 1
fi
