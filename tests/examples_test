#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
EXAMPLES_DIR="$SCRIPT_DIR/../examples"
ZPHP="${ZPHP:-$SCRIPT_DIR/../zig-out/bin/zphp}"

PHP="${PHP:-php}"
if ! command -v "$PHP" &>/dev/null; then
    echo "$PHP not found (PHP names the reference php)"
    exit 1
fi

passed=0
failed=0
# captured output is data: build the report with real newlines, not echo -e escapes
nl=$'\n'
errors=""

for dir in "$EXAMPLES_DIR"/*/; do
    name="$(basename "$dir")"
    main="$dir/main.php"
    if [ ! -f "$main" ]; then continue; fi
    if [ -f "$dir/.pending" ]; then echo "  skip  $name (pending)"; continue; fi

    php_out="$("$PHP" -d error_reporting=E_ALL\&~E_DEPRECATED\&~E_WARNING -d display_errors=0 -d zend.exception_ignore_args=0 -d zend.exception_string_param_max_len=15 "$main" 2>&1)" || true
    zphp_out="$("$ZPHP" -d error_reporting=E_ALL\&~E_DEPRECATED\&~E_WARNING run "$main" 2>&1)" || true

    if [ "$php_out" = "$zphp_out" ]; then
        passed=$((passed + 1))
        echo "  pass  $name"
    else
        failed=$((failed + 1))
        echo "  FAIL  $name"
        errors="$errors${nl}--- $name ---${nl}expected (php):${nl}$php_out${nl}got (zphp):${nl}$zphp_out${nl}"
    fi
done

echo ""
echo "$passed passed, $failed failed"

if [ $failed -gt 0 ]; then
    printf '%s\n' "$errors"
    exit 1
fi
