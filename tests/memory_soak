#!/usr/bin/env python3
"""Run tests/soak/memory.php and fail if the process keeps growing.

RSS is sampled while the script runs. The footprint may settle during the
first part of the run (allocator pools fill, caches warm), so the check
compares the peak seen between 30% and 60% of the run with the peak over the
whole tail: a steady state keeps the difference under GROWTH_LIMIT_MB.
"""
import os
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ZPHP = os.environ.get("ZPHP", os.path.join(ROOT, "zig-out", "bin", "zphp"))
ROUNDS = os.environ.get("SOAK_ROUNDS", "300000")
GROWTH_LIMIT_MB = float(os.environ.get("SOAK_GROWTH_LIMIT_MB", "8"))
PEAK_LIMIT_MB = float(os.environ.get("SOAK_PEAK_LIMIT_MB", "96"))
TIMEOUT_SECONDS = float(os.environ.get("SOAK_TIMEOUT", "900"))


def rss_mb(pid):
    out = subprocess.run(["ps", "-o", "rss=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    return int(out) / 1024 if out else None


def main():
    if not os.path.exists(ZPHP):
        print(f"error: {ZPHP} not found - build first", file=sys.stderr)
        return 2
    script = os.path.join(ROOT, "tests", "soak", "memory.php")
    proc = subprocess.Popen([ZPHP, "run", script, ROUNDS], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    started = time.time()
    samples = []
    while proc.poll() is None:
        if time.time() - started > TIMEOUT_SECONDS:
            proc.kill()
            print(f"fail: soak did not finish within {TIMEOUT_SECONDS:.0f}s")
            return 1
        rss = rss_mb(proc.pid)
        if rss is not None:
            samples.append((time.time() - started, rss))
        time.sleep(0.05)
    stdout, stderr = proc.communicate()
    elapsed = time.time() - started
    if proc.returncode != 0 or not stdout.startswith("done "):
        print(f"fail: zphp exited {proc.returncode}\n{stdout[:500]}\n{stderr[:2000]}")
        return 1
    if len(samples) < 10:
        print(f"fail: only {len(samples)} RSS samples in {elapsed:.1f}s - raise SOAK_ROUNDS")
        return 1
    warm = [r for t, r in samples if 0.3 * elapsed <= t < 0.6 * elapsed]
    tail = [r for t, r in samples if t >= 0.3 * elapsed]
    early = max(warm) if warm else max(tail)
    settled = max(tail)
    peak = max(r for _, r in samples)
    print(f"memory soak: {ROUNDS} rounds in {elapsed:.1f}s, {len(samples)} samples, peak {peak:.0f} MB, "
          f"30-60% peak {early:.0f} MB, tail peak {settled:.0f} MB, growth {settled - early:.1f} MB")
    if settled - early > GROWTH_LIMIT_MB:
        print(f"fail: footprint grew {settled - early:.1f} MB after warm-up (limit {GROWTH_LIMIT_MB:.0f} MB)")
        return 1
    if peak > PEAK_LIMIT_MB:
        print(f"fail: peak {peak:.0f} MB exceeds {PEAK_LIMIT_MB:.0f} MB")
        return 1
    print("pass")
    return 0


if __name__ == "__main__":
    sys.exit(main())
